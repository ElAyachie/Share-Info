<?xml version="1.0" encoding="utf-8"?>
<!-- The "$" from the Share Info icon on the portfolio site, white on transparent. Drawn on a
     768-unit grid (the size of the original artwork) and scaled into the adaptive icon's 72dp
     visible area. Each end of the S runs straight into its arrowhead, which overlaps the stroke
     slightly so no seam shows. Also used as the monochrome layer for themed icons. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="0.09375"
        android:scaleY="0.09375"
        android:translateX="18"
        android:translateY="18">
        <!-- Dot and stem -->
        <path android:fillColor="#FFFFFF" android:pathData="M373,166a24,24 0 1,0 48,0a24,24 0 1,0 -48,0z" />
        <path android:fillColor="#FFFFFF" android:pathData="M378,213h38v407h-38z" />
        <!-- The S -->
        <path
            android:pathData="M500.0,296.0 L467.6,285.6 C400.9,264.3 278,236 278,328 C278,416 512,390 512,478 C512,566 375.8,566.7 298.7,545.2 L266.0,536.0"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="56" />
        <!-- Arrowheads at the top and bottom ends of the S -->
        <path android:fillColor="#FFFFFF" android:pathData="M547.6,311.2 L481.6,340.5 L496.2,294.8 L510.8,249.1 Z" />
        <path android:fillColor="#FFFFFF" android:pathData="M217.9,522.5 L282.8,490.9 L269.9,537.1 L256.9,583.3 Z" />
    </group>
</vector>
